namespace {{ .Project.Name | pascalcase }}.Application.Security;

/// <summary>
/// Password hashing port. The default bridge ships a BCrypt implementation
/// (BcryptPasswordHasher) so user credentials are never stored in plain text.
/// </summary>
public interface IPasswordHasher
{
    /// <summary>Hash a plain-text password for storage.</summary>
    string HashPassword(string password);

    /// <summary>Verify a plaintext password against a stored hash.</summary>
    bool VerifyPassword(string hashedPassword, string providedPassword);
}