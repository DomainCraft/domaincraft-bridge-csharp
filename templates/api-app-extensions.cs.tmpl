/// <summary>
/// Builds the generated middleware pipeline, maps the API/health endpoints and
/// initializes the database schema + seed data at startup. Keeps Program.cs a
/// thin entry point — regenerate this file freely.
/// </summary>
public static class ApplicationBuilderExtensions
{
    public static WebApplication UseWebApiPipeline(this WebApplication app)
    {
        app.UseResponseCompression();

        // Security headers (Security/1.3).
        app.Use(async (context, next) =>
        {
            context.Response.Headers.Append("X-Content-Type-Options", "nosniff");
            context.Response.Headers.Append("X-Frame-Options", "DENY");
            context.Response.Headers.Append("Referrer-Policy", "strict-origin-when-cross-origin");
            context.Response.Headers.Append("Content-Security-Policy", "default-src 'self'");
            if (app.Environment.IsProduction())
            {
                context.Response.Headers.Append("Strict-Transport-Security", "max-age=31536000; includeSubDomains");
            }
            await next();
        });

{{- if .Project.HasRateLimit }}
        app.UseRateLimiter();
{{- end }}

        if (app.Environment.IsDevelopment())
        {
            app.UseSwagger();
            app.UseSwaggerUI(c =>
            {
                c.SwaggerEndpoint("/swagger/v1/swagger.json", "{{ .Project.Name }} API v1");
            });
        }

        if (!app.Environment.IsEnvironment("Testing"))
        {
            app.UseHttpsRedirection();
        }
        app.UseCors("CorsPolicy");

{{- if .Project.HasAuth }}
        app.UseAuthentication();
        app.UseAuthorization();
{{- end }}

        app.UseOutputCache();

        // Map data-layer exceptions to meaningful HTTP status codes instead of a bare 500:
        //   DbUpdateConcurrencyException — an optimistic-lock version conflict (409),
        //   DbUpdateException           — a FK/unique/constraint violation (409).
        //   HookException               — a business hook returned HookResult.Fail(...) (400).
        app.Use(async (context, next) =>
        {
            try
            {
                await next();
            }
            catch (HookException ex)
            {
                context.Response.StatusCode = StatusCodes.Status400BadRequest;
                await context.Response.WriteAsJsonAsync(new { message = ex.Message });
            }
            catch (DbUpdateConcurrencyException)
            {
                context.Response.StatusCode = StatusCodes.Status409Conflict;
                await context.Response.WriteAsJsonAsync(new { message = "Concurrency conflict: the resource was modified by another request" });
            }
            catch (DbUpdateException ex)
            {
                context.Response.StatusCode = StatusCodes.Status409Conflict;
                await context.Response.WriteAsJsonAsync(new { message = "A database constraint was violated", detail = ex.Message });
            }
        });

        return app;
    }

    public static WebApplication MapWebApiEndpoints(this WebApplication app)
    {
        app.MapControllers();

        // Health Checks endpoints
        app.MapHealthChecks("/health", new HealthCheckOptions
        {
            ResponseWriter = HealthCheckResponseWriter.WriteResponse,
            Predicate = _ => true
        });

        app.MapHealthChecks("/health/ready", new HealthCheckOptions
        {
            ResponseWriter = HealthCheckResponseWriter.WriteResponse,
            Predicate = check => check.Tags.Contains("ready")
        });

        app.MapHealthChecks("/health/live", new HealthCheckOptions
        {
            Predicate = _ => false
        });

{{- if and (gt (len .Project.Entities) 0) (.Project.HasAddon "dapr") }}
        // Hangfire dashboard + a periodic data-health/seed job (job only when seed data exists).
        app.UseHangfireDashboard();
{{- if $hasSeed }}
        RecurringJob.AddOrUpdate<DomainSeeder>("seed-check", seeder => seeder.SeedAsync(), Cron.Daily);
{{- end }}
{{- end }}

        return app;
    }

    /// <summary>
    /// Applies the schema strategy and runs the seeder at startup (skipped in the
    /// Testing environment — tests manage their own database).
    /// </summary>
    public static async Task InitializeWebApiDatabaseAsync(this WebApplication app)
    {
        if (app.Environment.IsEnvironment("Testing"))
        {
            return;
        }

        using (var scope = app.Services.CreateScope())
        {
            var logger = scope.ServiceProvider.GetRequiredService<ILogger<Program>>();
            try
            {
                var dbContext = scope.ServiceProvider.GetRequiredService<DomainDbContext>();

                // One, explicit schema strategy (never mix): `Database:SchemaMode`.
                //   "ensureCreated" (default) — creates the schema directly; fast for dev, but it does
                //     NOT create the __EFMigrationsHistory table, so it is incompatible with the
                //     `domaincraft generate --migrate` EF-migration workflow.
                //   "migrate" — applies pending EF Core migrations (`dotnet ef database update`),
                //     creating the history table. Choose this once you manage schema via migrations.
                // Mixing the two against the same database produces conflicting schema state, so pick
                // one per environment and keep the appsettings value consistent with your tooling.
                var schemaMode = app.Configuration["Database:SchemaMode"] ?? "ensureCreated";
                if (schemaMode == "migrate")
                {
                    await dbContext.Database.MigrateAsync();
                }
                else
                {
                    await dbContext.Database.EnsureCreatedAsync();
                }

                // Run seeder (only when the domain declares seed data)
{{- if $hasSeed }}
                var seeder = scope.ServiceProvider.GetRequiredService<DomainSeeder>();
                await seeder.SeedAsync();
{{- end }}
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "An error occurred during database initialization");
            }
        }
    }
}
