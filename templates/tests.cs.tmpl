    {
        var email = $"test_{Guid.NewGuid():N}@example.com";
        await _client.PostAsJsonAsync("/api/{{ $authRoute }}/register", new { email, password = "Password123!" });
        var loginResponse = await _client.PostAsJsonAsync("/api/{{ $authRoute }}/login", new { email, password = "wrong-password" });
        Assert.Equal(HttpStatusCode.Unauthorized, loginResponse.StatusCode);
    }

