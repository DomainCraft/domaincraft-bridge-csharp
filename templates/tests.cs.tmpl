/// <summary>
/// Auto-generated integration tests for the {{ $proj }} API.
/// Each test expects a specific HTTP status code based on entity permissions.
/// Tests run against a real PostgreSQL instance (Testcontainers), not an in-memory mock,
/// so FK constraints, unique indexes, on_delete cascades and SQL translation match
/// production. Requires Docker (available locally and in CI).
/// </summary>
public class ApiTests : IClassFixture<WebApplicationFactory<Program>>, IAsyncLifetime
{
    private WebApplicationFactory<Program> _factory;
    private HttpClient _client = null!;
    private readonly JsonSerializerOptions _jsonOptions = new() { PropertyNameCaseInsensitive = true };
    private readonly Dictionary<string, object> _createdIds = new();
    private readonly string _dbName = "test_" + Guid.NewGuid().ToString("N");

    // One PostgreSQL container shared by all tests in this run; each test gets its own
    // database inside it, so test runs are isolated from each other.
    private static readonly Lazy<PostgreSqlContainer> Postgres = new(() =>
    {
        var container = new PostgreSqlBuilder("postgres:16-alpine")
            .WithDatabase("postgres")
            .WithUsername("postgres")
            .WithPassword("postgres")
            .Build();
        container.StartAsync().GetAwaiter().GetResult();
        return container;
    });

    private string _connectionString = null!;

    public ApiTests(WebApplicationFactory<Program> factory)
    {
        _factory = factory;
    }

    public async Task InitializeAsync()
    {
        var container = Postgres.Value;
        await CreateDatabaseAsync(container);
        _connectionString = GetConnectionString(container);

        _factory = _factory.WithWebHostBuilder(builder =>
        {
            builder.UseEnvironment("Testing");

            // UseSetting (not just AddInMemoryCollection) so the overrides are visible to
            // Program's top-level statements: the DbContext registration reads
            // TestDb:ConnectionString from builder.Configuration while still in Program.cs.
            // AddInMemoryCollection is applied only after the app is built and would be too late.
            builder.UseSetting("TestDb:ConnectionString", _connectionString);
{{- if .Project.HasAuth }}
            builder.UseSetting("Jwt:Secret", "TestSecretKey123456789012345678901234567890");
            builder.UseSetting("Jwt:Issuer", "test-issuer");
            builder.UseSetting("Jwt:Audience", "test-audience");
{{- end }}
            builder.ConfigureAppConfiguration((context, config) =>
            {
                config.AddInMemoryCollection(new Dictionary<string, string?>
                {
{{- if .Project.HasAuth }}
                    ["Jwt:Secret"] = "TestSecretKey123456789012345678901234567890",
                    ["Jwt:Issuer"] = "test-issuer",
                    ["Jwt:Audience"] = "test-audience",
{{- end }}
                    ["ConnectionStrings:PostgreSQL"] = _connectionString,
                    ["TestDb:ConnectionString"] = _connectionString,
                });
            });

            builder.ConfigureServices(services =>
            {
{{- if $hasSeed }}
                // Remove the seeder — tests seed via HTTP endpoints
                var seederDescriptors = services.Where(d =>
                    d.ImplementationType == typeof(DomainSeeder))
                    .ToList();
                foreach (var d in seederDescriptors) services.Remove(d);
{{- end }}

                // Replace cache with no-op for tests
                var cacheDescriptors = services.Where(d =>
                    d.ServiceType?.Name == "ICacheService")
                    .ToList();
                foreach (var d in cacheDescriptors) services.Remove(d);
                services.AddSingleton<{{ $proj }}.Application.Caching.ICacheService, {{ $proj }}.Tests.NoOpCacheService>();
            });
        });
        _client = _factory.CreateClient();

        using var scope = _factory.Services.CreateScope();
        var context = scope.ServiceProvider.GetRequiredService<DomainDbContext>();
        await context.Database.EnsureCreatedAsync();

        await SeedTestEntities();
    }

    public async Task DisposeAsync()
    {
        var container = Postgres.Value;
        await DropDatabaseAsync(container);
    }

    private async Task CreateDatabaseAsync(PostgreSqlContainer container)
    {
        var adminCs = new NpgsqlConnectionStringBuilder(container.GetConnectionString())
        {
            Database = "postgres",
        };
        await using var conn = new NpgsqlConnection(adminCs.ConnectionString);
        await conn.OpenAsync();
        await using var cmd = new NpgsqlCommand($"CREATE DATABASE \"{_dbName}\"", conn);
        await cmd.ExecuteNonQueryAsync();
    }

    private async Task DropDatabaseAsync(PostgreSqlContainer container)
    {
        // Release app-side pooled connections and force-terminate any remaining
        // backends, otherwise DROP DATABASE fails with 55006 "is being accessed".
        NpgsqlConnection.ClearAllPools();
        var adminCs = new NpgsqlConnectionStringBuilder(container.GetConnectionString())
        {
            Database = "postgres",
        };
        await using var conn = new NpgsqlConnection(adminCs.ConnectionString);
        await conn.OpenAsync();
        await using (var term = new NpgsqlCommand(
            $"SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '{_dbName}' AND pid <> pg_backend_pid()", conn))
        {
            await term.ExecuteNonQueryAsync();
        }
        await using var cmd = new NpgsqlCommand($"DROP DATABASE IF EXISTS \"{_dbName}\"", conn);
        await cmd.ExecuteNonQueryAsync();
    }

    private string GetConnectionString(PostgreSqlContainer container)
    {
        var cs = new NpgsqlConnectionStringBuilder(container.GetConnectionString())
        {
            Database = _dbName,
            IncludeErrorDetail = true,
        };
        return cs.ConnectionString;
    }

