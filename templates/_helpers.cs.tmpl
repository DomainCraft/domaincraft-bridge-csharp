{{- /* Shared named templates for the C# bridge. Loaded via bridge.yaml "helpers" field. */ -}}

{{- /* seedValueExpression converts a seed data value to a C# expression.
     Context: dict with "Field" (IRField-like) and "Value" (the seed value).
     Used by both seed-seeder.cs.tmpl and controller.cs.tmpl Seed action.
     The literal syntax is loaded from type_mappings.yaml; this template only
     decides the password-hash special case and the array recursion. */ -}}
{{- define "seedValueExpression" -}}
{{- $kind := .Kind -}}
{{- $dbType := .DBType -}}
{{- $value := .Value -}}
{{- $field := .Field -}}
{{- if eq $kind "array" -}}
{{- $inner := .ElementType -}}
{{- if kindIs "slice" $value -}}
{{ arrayLiteralOpen $dbType }} {{- range $index, $item := $value -}}{{- if $index }}, {{ end -}}{{ template "seedValueExpression" (dict "Kind" (seedKind $inner) "DBType" $inner "ElementType" $inner "Value" $item "Field" $field) }}{{- end -}}{{ arrayLiteralClose }}
{{- else -}}
{{ literalDefault $dbType }}
{{- end -}}
{{- else if eq $kind "text" -}}
{{- if and .HasAuth $field (eq (lower $field) "password") (not (hasPrefix "$2" (toString $value))) -}}
_passwordHasher.HashPassword({{ literalValue $dbType $value }})
{{- else -}}
{{ literalValue $dbType $value }}
{{- end -}}
{{- else -}}
{{ literalValue $dbType $value }}
{{- end -}}
{{- end -}}

{{- /* defaultValueLiteral emits the expression for a field's explicit
     .DefaultValue (from domain.yaml), via the bridge's literal mapping loaded
     from type_mappings.yaml. Shared by defaultValueExpression and the entity
     property initializer. */ -}}
{{- define "defaultValueLiteral" -}}
{{- if .DefaultIsFunc -}}{{ literalDefault .DatabaseType }}
{{- else if .IsEnum -}}{{ literalMember .DatabaseType .DefaultValue }}
{{- else -}}{{ literalValue .DatabaseType .DefaultValue }}
{{- end -}}
{{- end -}}

{{- /* defaultValueExpression generates a C# default value expression for a field.
     Uses .DefaultValue from YAML when available, falls back to type-based defaults.
     Context: IRField-like dict with .DatabaseType, .DefaultValue, .DefaultIsFunc. */ -}}
{{- define "defaultValueExpression" -}}
{{- if .DefaultValue -}}{{ template "defaultValueLiteral" . }}
{{- else -}}{{ literalDefault .DatabaseType }}
{{- end -}}
{{- end -}}

{{- /* authOrAuthorize emits the auth attribute from the CORE-computed permission plan.
     Context: dict with "Plan" (IRPermissionPlan or nil), "Entity", "Op".
     The plan already decomposes the roles into IsPublic / HasOwner / Roles, so
     this bridge no longer parses "*" wildcards or "@Owner" tokens. */ -}}
{{- define "authOrAuthorize" -}}
{{- $plan := .Plan -}}
{{- $entity := .Entity -}}
{{- $op := .Op -}}
{{- if not $plan }}
    [AllowAnonymous]
{{- else if $plan.IsPublic }}
    [AllowAnonymous]
{{- else if and (not $plan.HasOwner) (eq (len $plan.Roles) 0) }}
{{- /* permissions declared but this operation has no roles/token → no attribute */ -}}
{{- else }}
    [Authorize(Policy = "{{ $entity }}{{ $op }}")]
{{- end }}
{{- end -}}

{{- /* ownerCheck emits the boolean expression that guards an @Owner operation: forbid
     unless the caller is the owner OR holds at least one explicit role from the
     plan's Roles (the bypass roles are already extracted by the core).
     Context: dict with "Plan" (IRPermissionPlan) and "Var" (the entity expression). */ -}}
{{- define "ownerCheck" -}}
{{- $plan := .Plan -}}
{{- $var := .Var -}}
{{- if gt (len $plan.Roles) 0 }}!_permissionService.HasAnyRole(new[] { {{- range $i, $r := $plan.Roles }}{{ if $i }}, {{ end }}"{{ $r }}"{{- end }} }) && {{ end }}!_permissionService.IsOwner({{ $var }}){{- end -}}

{{- /* validationAttributes emits C# validation attributes from the CORE's normalized
     validation rules (IRField.ValidationRules()). The core has already classified
     each rule (required / email / url / ipv4 / regex / min_length / max_length /
     min_value / max_value) AND assigned a stable Code + default Message, so this
     bridge only maps each rule to a DataAnnotations attribute — it neither
     re-derives which modifier is a length vs a numeric bound, nor hardcodes the
     message text. Context: IRField. */ -}}
{{- define "validationAttributes" -}}
{{- $field := . -}}
{{- $rules := .ValidationRules -}}
{{- $isRequired := false -}}{{- $isEmail := false -}}{{- $isUrl := false -}}
{{- $minLen := "" -}}{{- $maxLen := "" -}}{{- $regex := "" -}}{{- $minVal := "" -}}{{- $maxVal := "" -}}
{{- $reqMsg := "" -}}{{- $emailMsg := "" -}}{{- $urlMsg := "" -}}{{- $regexMsg := "" -}}{{- $minLenMsg := "" -}}{{- $maxLenMsg := "" -}}{{- $minValMsg := "" -}}{{- $maxValMsg := "" -}}
{{- range $rules -}}
{{- if eq .Kind "required" }}{{ $isRequired = true }}{{ $reqMsg = .Message }}{{ end -}}
{{- if eq .Kind "email" }}{{ $isEmail = true }}{{ $emailMsg = .Message }}{{ end -}}
{{- if eq .Kind "url" }}{{ $isUrl = true }}{{ $urlMsg = .Message }}{{ end -}}
{{- if eq .Kind "min_length" }}{{ $minLen = .Value }}{{ $minLenMsg = .Message }}{{ end -}}
{{- if eq .Kind "max_length" }}{{ $maxLen = .Value }}{{ $maxLenMsg = .Message }}{{ end -}}
{{- if eq .Kind "regex" }}{{ $regex = .Value }}{{ $regexMsg = .Message }}{{ end -}}
{{- if eq .Kind "min_value" }}{{ $minVal = .Value }}{{ $minValMsg = .Message }}{{ end -}}
{{- if eq .Kind "max_value" }}{{ $maxVal = .Value }}{{ $maxValMsg = .Message }}{{ end -}}
{{- end -}}
{{- if and $isRequired (not $field.IsJson) }}
    [Required(ErrorMessage = "{{ $reqMsg }}")]
{{- end }}
{{- if $isEmail }}
    [EmailAddress(ErrorMessage = "{{ $emailMsg }}")]
{{- end }}
{{- if $isUrl }}
    [Url(ErrorMessage = "{{ $urlMsg }}")]
{{- end }}
{{- if and $regex (ne $regex "^") }}
    [RegularExpression("{{ $regex }}", ErrorMessage = "{{ $regexMsg }}")]
{{- end }}
{{- if and $minLen $maxLen }}
    [StringLength({{ $maxLen }}, MinimumLength = {{ $minLen }}, ErrorMessage = "must be between {{ $minLen }} and {{ $maxLen }} characters")]
{{- else if $maxLen }}
    [StringLength({{ $maxLen }}, ErrorMessage = "{{ $maxLenMsg }}")]
{{- else if $minLen }}
    [StringLength(int.MaxValue, MinimumLength = {{ $minLen }}, ErrorMessage = "{{ $minLenMsg }}")]
{{- end }}
{{- if and $minVal $maxVal }}
    [Range({{ $minVal }}, {{ $maxVal }}, ErrorMessage = "must be between {{ $minVal }} and {{ $maxVal }}")]
{{- else if $minVal }}
{{- if $field.IsBigInt }}
    [Range({{ $minVal }}, long.MaxValue, ErrorMessage = "{{ $minValMsg }}")]
{{- else if $field.IsFloat }}
    [Range({{ $minVal }}, double.MaxValue, ErrorMessage = "{{ $minValMsg }}")]
{{- else }}
    [Range({{ $minVal }}, int.MaxValue, ErrorMessage = "{{ $minValMsg }}")]
{{- end }}
{{- else if $maxVal }}
{{- if $field.IsBigInt }}
    [Range(long.MinValue, {{ $maxVal }}, ErrorMessage = "{{ $maxValMsg }}")]
{{- else if $field.IsFloat }}
    [Range(double.MinValue, {{ $maxVal }}, ErrorMessage = "{{ $maxValMsg }}")]
{{- else }}
    [Range(int.MinValue, {{ $maxVal }}, ErrorMessage = "{{ $maxValMsg }}")]
{{- end }}
{{- end }}
{{- end -}}

{{- /* dtoFieldProperties emits C# properties for a DTO field (used in Dto, CreateRequest, UpdateRequest).
     Context: IRField (or dict with .Name, .IsRelation, .IsMany, .DatabaseType, .IsNullable, .IsHidden, .IsPrimary). */ -}}
{{- define "dtoFieldProperties" -}}
{{- if .IsRelation -}}
{{- if .IsMany }}
        [JsonPropertyName("{{ .Name | camelcase }}")]
        public virtual ICollection<{{ .RelationTarget }}> {{ .Name | pascalcase }} { get; set; } = new List<{{ .RelationTarget }}>();
{{- else }}
        [JsonPropertyName("{{ .Name | camelcase }}")]
        public {{ languageType .DatabaseType .IsNullable }} {{ fkName .Name | pascalcase }} { get; set; }
{{- end -}}
{{- else }}
{{- if .IsHidden }}
        [JsonIgnore]
{{- end }}
        [JsonPropertyName("{{ .Name | camelcase }}")]
        public {{ languageType .DatabaseType .IsNullable }} {{ .Name | pascalcase }} { get; set; }
{{- end -}}
{{- end -}}

{{- /* requestFieldProperties emits C# properties for Create/Update request DTOs with validation attributes.
     Context: IRField. */ -}}
{{- define "requestFieldProperties" -}}
{{- if .IsRelation -}}
{{- if not .IsMany }}
        [JsonPropertyName("{{ .Name | camelcase }}")]
        public {{ languageType .DatabaseType .IsNullable }} {{ fkName .Name | pascalcase }} { get; set; }
{{- end -}}
{{- else }}
{{- template "validationAttributes" . }}
        [JsonPropertyName("{{ .Name | camelcase }}")]
        public {{ languageType .DatabaseType .IsNullable }} {{ .Name | pascalcase }} { get; set; }
{{- end -}}
{{- end -}}

{{- /* mapFieldToDto emits a DTO mapping line for one field.
     Context: IRField. */ -}}
{{- define "mapFieldToDto" -}}
{{- if .IsRelation -}}
{{- if .IsMany }}
            {{ .Name | pascalcase }} = entity.{{ .Name | pascalcase }},
{{- else }}
            {{ fkName .Name | pascalcase }} = entity.{{ fkName .Name | pascalcase }},
{{- end -}}
{{- else }}
            {{ .Name | pascalcase }} = entity.{{ .Name | pascalcase }},
{{- end -}}
{{- end -}}

{{- /* mapRequestToEntity emits a request-to-entity mapping line for one field.
     Context: IRField. */ -}}
{{- define "mapRequestToEntity" -}}
{{- if .IsRelation -}}
{{- if not .IsMany }}
        entity.{{ fkName .Name | pascalcase }} = request.{{ fkName .Name | pascalcase }};
{{- end -}}
{{- else }}
        entity.{{ .Name | pascalcase }} = request.{{ .Name | pascalcase }};
{{- end -}}
{{- end -}}

{{/* ===== Test helpers: shared by the split tests/*.cs.tmpl templates ===== */}}

{{- /* testFieldValue emits a single C# object-initializer line for one field.
     Context: IRField. Relations map onto the FK-named entity property. Scalar
     literal syntax (Guid.NewGuid, 1L, 1.0m, DateTime.UtcNow, new List<...>) is
     loaded from type_mappings.yaml; this template keeps only the test-specific
     value choices (email/url/name strings, relation FK lookups). */ -}}
{{- define "testFieldValue" }}
{{- if .IsRelation }}
{{- if .IsNullable }}
            {{ fkName .Name | pascalcase }} = _createdIds.TryGetValue("{{ .RelationTarget }}", out var {{ fkName .Name | camelcase }}Pk) ? ({{ languageType .DatabaseType true }})({{ fkName .Name | camelcase }}Pk) : null,
{{- else }}
            {{ fkName .Name | pascalcase }} = _createdIds.TryGetValue("{{ .RelationTarget }}", out var {{ fkName .Name | camelcase }}Pk) ? ({{ languageType .DatabaseType false }})({{ fkName .Name | camelcase }}Pk) : default,
{{- end }}
{{- else if .IsUuid }}
            {{ .Name | pascalcase }} = {{ literalDefault .DatabaseType }},
{{- else if .IsText }}
{{- if .HasValidation "email" }}
            {{ .Name | pascalcase }} = "test@example.com",
{{- else if .HasValidation "url" }}
            {{ .Name | pascalcase }} = "https://example.com",
{{- else if .DefaultValue }}
            {{ .Name | pascalcase }} = {{ literalValue .DatabaseType .DefaultValue }},
{{- else }}
            {{ .Name | pascalcase }} = "test_{{ .Name | lowercase }}",
{{- end }}
{{- else if .IsInteger }}
            {{ .Name | pascalcase }} = {{ literalValue .DatabaseType "1" }},
{{- else if .IsFloat }}
            {{ .Name | pascalcase }} = {{ literalValue .DatabaseType "1.0" }},
{{- else if .IsBoolean }}
            {{ .Name | pascalcase }} = {{ literalValue .DatabaseType "true" }},
{{- else if or .IsDateTime .IsDate }}
            {{ .Name | pascalcase }} = {{ literalDefault .DatabaseType }},
{{- else if .IsArray }}
{{- $inner := .ArrayElementType }}
{{- $kind := seedKind $inner }}
{{- if .IsEnum }}
            {{ .Name | pascalcase }} = {{ literalDefault .DatabaseType }},
{{- else if eq $kind "text" }}
{{- if .HasValidation "email" }}
            {{ .Name | pascalcase }} = {{ arrayLiteralOpen .DatabaseType }} "test@example.com" {{ arrayLiteralClose }},
{{- else if .HasValidation "url" }}
            {{ .Name | pascalcase }} = {{ arrayLiteralOpen .DatabaseType }} "https://example.com" {{ arrayLiteralClose }},
{{- else }}
            {{ .Name | pascalcase }} = {{ arrayLiteralOpen .DatabaseType }} "test_{{ .Name | lowercase }}" {{ arrayLiteralClose }},
{{- end }}
{{- else if eq $kind "uuid" }}
            {{ .Name | pascalcase }} = {{ arrayLiteralOpen .DatabaseType }} {{ literalDefault $inner }} {{ arrayLiteralClose }},
{{- else if eq $kind "int" }}
            {{ .Name | pascalcase }} = {{ arrayLiteralOpen .DatabaseType }} {{ literalValue $inner "1" }} {{ arrayLiteralClose }},
{{- else if eq $kind "bigint" }}
            {{ .Name | pascalcase }} = {{ arrayLiteralOpen .DatabaseType }} {{ literalValue $inner "1" }} {{ arrayLiteralClose }},
{{- else if eq $kind "float" }}
            {{ .Name | pascalcase }} = {{ arrayLiteralOpen .DatabaseType }} {{ literalValue $inner "1.0" }} {{ arrayLiteralClose }},
{{- else if eq $kind "decimal" }}
            {{ .Name | pascalcase }} = {{ arrayLiteralOpen .DatabaseType }} {{ literalValue $inner "1.0" }} {{ arrayLiteralClose }},
{{- else if or (eq $kind "datetime") (eq $kind "date") }}
            {{ .Name | pascalcase }} = {{ arrayLiteralOpen .DatabaseType }} {{ literalDefault $inner }} {{ arrayLiteralClose }},
{{- else if eq $kind "bool" }}
            {{ .Name | pascalcase }} = {{ arrayLiteralOpen .DatabaseType }} {{ literalValue $inner "true" }} {{ arrayLiteralClose }},
{{- end }}
{{- else if .IsEnum }}
{{- if .DefaultValue }}
            {{ .Name | pascalcase }} = {{ literalMember .DatabaseType .DefaultValue }},
{{- else }}
            {{ .Name | pascalcase }} = {{ literalDefault .DatabaseType }},
{{- end }}
{{- end }}
{{- end }}

{{- /* testAuthEntityFields emits object-initializer lines for the auth entity's
     required scalar fields, skipping identity/relations/feature fields and the
     email/password/role fields (set explicitly by CreateDbUserAsync). Used so a
     Db-context-direct user insert satisfies every NOT NULL column the auth entity
     declares. Context: the auth IREntity. */ -}}
{{- define "testAuthEntityFields" }}
{{- range .Fields }}
{{- $n := .Name | lower }}
{{- if and (not .IsPrimary) (not .IsMany) (not .IsRelation) (not (.IsFeatureField)) (ne $n "email") (ne $n "password") (ne $n "role") }}
{{- template "testFieldValue" . }}
{{- end }}
{{- end }}
{{- end }}

{{- /* testConcurrencyBody emits the HTTP create/update body for the optimistic-lock
     concurrency test. All required (non-nullable, non-readonly) fields are included:
     relations to the auth entity point at a freshly created owner (so the row doesn't
     collide with the seeded row that already owns one), all other relations map via
     _createdIds (JSON relation name) and scalars via testFieldValue. Optional fields
     are omitted. Context: dict with "Entity", "AuthName", "AuthPk" and optional
     "Suffix" (avoids duplicate out-vars when the body is emitted twice in one scope). */ -}}
{{- define "testConcurrencyBody" }}
{{- $e := .Entity }}
{{- $authName := .AuthName }}
{{- $authPk := .AuthPk }}
{{- $suffix := default "" .Suffix }}
{{- range $e.Fields }}
{{- if and (not .IsPrimary) (not .IsMany) (not (.IsFeatureField)) (not .IsNullable) (not .IsReadonly) }}
{{- if .IsRelation }}
{{- if eq .RelationTarget $authName }}
            {{ .Name | pascalcase }} = ownerUser.{{ $authPk }},
{{- else }}
            {{ .Name | pascalcase }} = _createdIds.TryGetValue("{{ .RelationTarget }}", out var {{ .Name | camelcase }}{{ $suffix }}Ck) ? ({{ languageType .DatabaseType false }})({{ .Name | camelcase }}{{ $suffix }}Ck) : default,
{{- end }}
{{- else }}
{{- template "testFieldValue" . }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}

{{- /* testRequestBody builds a CLR entity object-initializer (relations → FK entity
     property). Context: IRField. */ -}}
{{- define "testRequestBody" }}
{{- range .Fields }}
{{- if and (not .IsPrimary) (not .IsMany) }}
{{- if not (.IsFeatureField) }}
{{- template "testFieldValue" . }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}

{{- /* testHttpRequestBody builds an HTTP request object-initializer (relations → JSON
     name camelCase, matching controller DTO [JsonPropertyName]). Context: dict with
     "Entity" and optional "Suffix" (used to avoid duplicate out-vars on second use in
     the same method's scope). */ -}}
{{- define "testHttpRequestBody" }}
{{- $entity := .Entity }}
{{- $suffix := default "" .Suffix }}
{{- range $entity.Fields }}
{{- if and (not .IsPrimary) (not .IsMany) }}
{{- if not (.IsFeatureField) }}
{{- if .IsRelation }}
{{- if .IsNullable }}
            {{ .Name | pascalcase }} = _createdIds.TryGetValue("{{ .RelationTarget }}", out var {{ .Name | camelcase }}{{ $suffix }}Pk) ? ({{ languageType .DatabaseType true }})({{ .Name | camelcase }}{{ $suffix }}Pk) : null,
{{- else }}
            {{ .Name | pascalcase }} = _createdIds.TryGetValue("{{ .RelationTarget }}", out var {{ .Name | camelcase }}{{ $suffix }}Pk) ? ({{ languageType .DatabaseType false }})({{ .Name | camelcase }}{{ $suffix }}Pk) : default,
{{- end }}
{{- else }}
{{- template "testFieldValue" . }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
