{{- $hasSeed := false -}}
{{- range .Project.Entities }}{{ if .Seed }}{{ $hasSeed = true }}{{ end }}{{- end -}}
using System.Text;
{{- if .Project.HasAuth }}
using Microsoft.AspNetCore.Authentication.JwtBearer;
using Microsoft.IdentityModel.Tokens;
{{- end }}
using Asp.Versioning;
using Microsoft.AspNetCore.Diagnostics.HealthChecks;
using Microsoft.AspNetCore.ResponseCompression;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Diagnostics.HealthChecks;
using Microsoft.OpenApi;
using System.IO.Compression;
using System.Threading.RateLimiting;
using Microsoft.AspNetCore.RateLimiting;
using {{ .Project.Name | pascalcase }}.Application;
using {{ .Project.Name | pascalcase }}.Infrastructure;
using {{ .Project.Name | pascalcase }}.Infrastructure.Persistence;
{{- if $hasSeed }}
using {{ .Project.Name | pascalcase }}.Infrastructure.Persistence.Seeders;
{{- end }}
using {{ .Project.Name | pascalcase }}.WebApi.HealthChecks;
{{- if .Project.HasAddon "dapr" }}
using Dapr.Client;
{{- if gt (len .Project.Entities) 0 }}
using Hangfire;
using Hangfire.PostgreSql;
{{- end }}
{{- end }}
{{- if .Project.HasAddon "observability" }}
using Serilog;
using OpenTelemetry;
using OpenTelemetry.Trace;
{{- end }}

var builder = WebApplication.CreateBuilder(args);

{{- if .Project.HasAuth }}
// Configuration
var jwtSecret = builder.Configuration["Jwt:Secret"] ?? throw new InvalidOperationException("JWT secret not configured");
var jwtIssuer = builder.Configuration["Jwt:Issuer"] ?? "{{ .Project.Name }}";
var jwtAudience = builder.Configuration["Jwt:Audience"] ?? "{{ .Project.Name }}-api";
{{- end }}

// Add services
if (builder.Environment.IsEnvironment("Testing"))
{
    // Integration tests run against a real PostgreSQL via Testcontainers, so FK constraints,
    // unique indexes, on_delete cascades and SQL translation match production exactly.
    var testConn = builder.Configuration["TestDb:ConnectionString"];
    if (!string.IsNullOrEmpty(testConn))
    {
        builder.Services.AddDbContextPool<DomainDbContext>(options =>
        {
            options.UseNpgsql(testConn, npg =>
            {
                npg.MigrationsAssembly("{{ .Project.Name | pascalcase }}.Infrastructure");
                npg.EnableRetryOnFailure(3);
                npg.CommandTimeout(30);
            });
        }, poolSize: 128);
    }
    else
    {
        // Fallback only when no connection string is supplied (e.g. no Docker available):
        // the in-memory mock. Generated tests always pass TestDb:ConnectionString.
        var testDbName = builder.Configuration["TestDb:Name"] ?? "TestDb";
        builder.Services.AddDbContext<DomainDbContext>(options =>
        {
            options.UseInMemoryDatabase(testDbName);
        });
    }
}
else
{
    builder.Services.AddDbContextPool<DomainDbContext>(options =>
    {
        var connectionString = builder.Configuration.GetConnectionString("PostgreSQL")
            ?? throw new InvalidOperationException("PostgreSQL connection string not configured");
        options.UseNpgsql(connectionString, npg =>
        {
            npg.MigrationsAssembly("{{ .Project.Name | pascalcase }}.Infrastructure");
            npg.EnableRetryOnFailure(3);
            npg.CommandTimeout(30);
        });
    }, poolSize: 128);
}

// Health Checks (skip external service checks in Testing environment)
var healthChecksBuilder = builder.Services.AddHealthChecks();
if (!builder.Environment.IsEnvironment("Testing"))
{
    healthChecksBuilder
        .AddNpgSql(builder.Configuration.GetConnectionString("PostgreSQL") ?? "", name: "postgresql");
}

// Response compression (Brotli + Gzip)
builder.Services.AddResponseCompression(options =>
{
    options.EnableForHttps = true;
    options.Providers.Add<BrotliCompressionProvider>();
    options.Providers.Add<GzipCompressionProvider>();
});
builder.Services.Configure<BrotliCompressionProviderOptions>(options => options.Level = CompressionLevel.Fastest);
builder.Services.Configure<GzipCompressionProviderOptions>(options => options.Level = CompressionLevel.Fastest);

// Output caching — opt-in via [OutputCache] on stable, non-variant endpoints.
// The default policy is NoCache because generated GET endpoints are paginated,
// sorted, searched and (often) user/tenant aware. Add an explicit policy +
// attribute when you know a route is cache-safe.
builder.Services.AddOutputCache(options =>
{
    options.AddBasePolicy(policy => policy.NoCache());
});

{{- if .Project.HasRateLimit }}
// Rate limiting (Security/1.3). The policy name "api" is referenced from every
// controller's [EnableRateLimiting("api")]; limits come from project.rate_limit.
builder.Services.AddRateLimiter(options =>
{
    options.RejectionStatusCode = StatusCodes.Status429TooManyRequests;
{{- if eq .Project.RateLimit.Policy "sliding" }}
    options.AddSlidingWindowLimiter("api", limiter =>
    {
        limiter.PermitLimit = {{ .Project.RateLimit.PermitLimit }};
        limiter.Window = TimeSpan.FromSeconds({{ .Project.RateLimit.WindowSeconds }});
        limiter.SegmentsPerWindow = 4;
    });
{{- else }}
    options.AddFixedWindowLimiter("api", limiter =>
    {
        limiter.PermitLimit = {{ .Project.RateLimit.PermitLimit }};
        limiter.Window = TimeSpan.FromSeconds({{ .Project.RateLimit.WindowSeconds }});
    });
{{- end }}
    options.OnRejected = async (context, cancellationToken) =>
    {
        context.HttpContext.Response.Headers["Retry-After"] = "{{ .Project.RateLimit.WindowSeconds }}";
        await ValueTask.CompletedTask;
    };
});
{{- end }}

// HttpContextAccessor is registered unconditionally — PermissionService needs it
// even for auth-less and permission-only projects.
builder.Services.AddHttpContextAccessor();

{{- if .Project.HasAuth }}
// Authentication - JWT
builder.Services.AddAuthentication(JwtBearerDefaults.AuthenticationScheme)
    .AddJwtBearer(options =>
    {
        options.TokenValidationParameters = new TokenValidationParameters
        {
            ValidateIssuerSigningKey = true,
            IssuerSigningKey = new SymmetricSecurityKey(Encoding.ASCII.GetBytes(jwtSecret)),
            ValidateIssuer = true,
            ValidIssuer = jwtIssuer,
            ValidateAudience = true,
            ValidAudience = jwtAudience,
            ValidateLifetime = true,
            ClockSkew = TimeSpan.FromSeconds(10),
        };

        options.Events = new JwtBearerEvents
        {
            OnAuthenticationFailed = context =>
            {
                if (context.Exception is SecurityTokenExpiredException)
                    context.Response.Headers.Add("X-Token-Expired", "true");
                return Task.CompletedTask;
            },
        };
    });

// Authorization
builder.Services.AddAuthorization(options =>
{
{{- range $op := list "Read" "Create" "Update" "Delete" }}
{{- range $.Project.Entities }}
{{- $perms := .Permissions }}
{{- if $perms }}
{{- $roles := "" -}}
{{- if eq $op "Read" }}{{ $roles = $perms.Read }}{{ end -}}
{{- if eq $op "Create" }}{{ $roles = $perms.Create }}{{ end -}}
{{- if eq $op "Update" }}{{ $roles = $perms.Update }}{{ end -}}
{{- if eq $op "Delete" }}{{ $roles = $perms.Delete }}{{ end -}}
{{- if and $roles (not (isPublicPermission $roles)) }}
{{- /* Role lists are OR (any role passes), and "@Owner" is validated in the
       controller via IPermissionService (owner OR explicit role). Building the
       policy with multiple policy.RequireRole(...) calls would mean AND, so we
       emit a single RequireAssertion that ORs the explicit roles instead. */ -}}
{{- $hasOwner := false }}
{{- $explicit := list }}
{{- range $roles }}
{{- if hasPrefix "@" . }}{{ $hasOwner = true }}{{- else if ne . "*" }}{{ $explicit = append $explicit . }}{{- end }}
{{- end }}
    options.AddPolicy("{{ .Name }}{{ $op }}", policy =>
    {
        policy.RequireAuthenticatedUser();
{{- if $hasOwner }}
        // @Owner and role checks are enforced in the controller (owner OR explicit role).
{{- else if gt (len $explicit) 0 }}
        policy.RequireAssertion(context =>{{ range $i, $r := $explicit }}{{ if $i }} ||{{ end }} context.User.IsInRole("{{ $r }}"){{ end }});
{{- end }}
    });
{{- end }}
{{- end }}
{{- end }}
{{- end }}
});
{{- end }}

// Register services
{{- if $hasSeed }}
builder.Services.AddScoped<DomainSeeder>();
{{- end }}
builder.Services.AddApplicationServices();
builder.Services.AddInfrastructureServices();
{{- if .Project.HasAddon "dapr" }}
// Dapr sidecar (state, pub/sub, secrets, actors) — interacts via gRPC.
builder.Services.AddDaprClient();
{{- end }}

{{- if and (gt (len .Project.Entities) 0) (.Project.HasAddon "dapr") }}
// Background processing (Hangfire) — the recurring seed/health job is stored in
// the same PostgreSQL database. Jobs are lightweight and durable; swap for a
// distributed worker (e.g. via Dapr actors) as the workload grows.
builder.Services.AddHangfire(config => config
    .SetDataCompatibilityLevel(CompatibilityLevel.Version_180)
    .UseSimpleAssemblyNameTypeSerializer()
    .UseRecommendedSerializerSettings()
    .UsePostgreSqlStorage(options =>
        options.UseNpgsqlConnection(builder.Configuration.GetConnectionString("PostgreSQL") ?? "")));
builder.Services.AddHangfireServer();
{{- end }}

{{- if .Project.HasVersioning }}
// API versioning — the default version and on/off come from project.versioning.
builder.Services.AddApiVersioning(options =>
{
    // URLs stay clean (no version segment); a specific version satisfies
    // unversioned calls. Controllers opt in with [ApiVersion("{{ .Project.Versioning.DefaultVersion }}")].
{{- $verParts := splitList "." (.Project.Versioning.DefaultVersion) }}
{{- $verMajor := index $verParts 0 | atoi }}
{{- $verMinor := 0 }}
{{- if gt (len $verParts) 1 }}{{ $verMinor = index $verParts 1 | atoi }}{{ end }}
    options.DefaultApiVersion = new ApiVersion({{ $verMajor }}, {{ $verMinor }});
    options.AssumeDefaultVersionWhenUnspecified = true;
    options.ReportApiVersions = true;
}).AddApiExplorer(options =>
    options.GroupNameFormat = "'v'VVV");
{{- end }}

builder.Services.AddControllers()
    .AddJsonOptions(options =>
    {
        options.JsonSerializerOptions.DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull;
        options.JsonSerializerOptions.Converters.Add(new System.Text.Json.Serialization.JsonStringEnumConverter());
    });

// Logging
{{- if .Project.HasAddon "observability" }}
// --addons observability: structured logging (Serilog) + distributed tracing
// (OpenTelemetry → Jaeger). Both are config-driven and disabled by default:
//   - Logs go to Console; enable the Seq sink by setting `Seq:Url` (e.g. from
//     appsettings.json or env `Seq__Url`).
//   - Tracing starts only when `Jaeger:Enabled` is true (see docker-compose). When
//     running on a single host, add `SourceContext` enricher for correlation.
builder.Host.UseSerilog((context, config) =>
{
    config.ReadFrom.Configuration(context.Configuration);
    var seqUrl = context.Configuration["Seq:Url"];
    if (!string.IsNullOrEmpty(seqUrl))
        config.WriteTo.Seq(seqUrl);
    else
        config.WriteTo.Console();
});

if (builder.Configuration.GetValue<bool>("Jaeger:Enabled"))
{
    builder.Services.AddOpenTelemetry().WithTracing(tracing =>
        tracing.AddAspNetCoreInstrumentation().AddJaegerExporter());
}
{{- else }}
builder.Logging.ClearProviders();
builder.Logging.AddConsole();
builder.Logging.AddDebug();
{{- end }}

// Swagger/OpenAPI — no AddEndpointsApiExplorer: the (later-registered) plain
// endpoint explorer would override Asp.Versioning's explorer and empty the spec.
builder.Services.AddSwaggerGen(c =>
{
    c.SwaggerDoc("v1", new OpenApiInfo
    {
        Title = "{{ .Project.Name }} API",
        Version = "v1",
        Description = "Generated REST API for {{ .Project.Name }} domain model",
        Contact = new OpenApiContact { Name = "Support" },
    });

{{- if .Project.HasAuth }}
    // JWT Security Definition
    var securityScheme = new OpenApiSecurityScheme
    {
        Name = "JWT Authentication",
        Description = "Enter JWT Bearer token",
        In = ParameterLocation.Header,
        Type = SecuritySchemeType.Http,
        Scheme = "bearer",
        BearerFormat = "JWT",
    };

    c.AddSecurityDefinition("Bearer", securityScheme);
    c.AddSecurityRequirement(_ => new OpenApiSecurityRequirement
    {
        { new OpenApiSecuritySchemeReference("Bearer"), new List<string>() }
    });
{{- end }}
});

// CORS — single "CorsPolicy": origins from appsettings `Cors:AllowedOrigins` at
// runtime, else from `project.cors` (compile time), else allow-all for dev.
builder.Services.AddCors(options =>
{
    var configuredOrigins = builder.Configuration.GetSection("Cors:AllowedOrigins").Get<string[]>();
    if (configuredOrigins is { Length: > 0 })
    {
        options.AddPolicy("CorsPolicy", policy =>
            policy.WithOrigins(configuredOrigins)
                  .AllowAnyMethod()
                  .AllowAnyHeader()
                  .AllowCredentials());
    }
{{- if and .Project.CORS .Project.CORS.Enabled .Project.CORS.Origins }}
    else
    {
        options.AddPolicy("CorsPolicy", policy =>
            policy.WithOrigins(
{{- range $i, $origin := .Project.CORS.Origins }}
{{- if $i }},{{ end }}
                "{{ $origin }}"
{{- end }}
            )
            .AllowAnyMethod()
            .AllowAnyHeader()
            .AllowCredentials());
    }
{{- else }}
    else
    {
        options.AddPolicy("CorsPolicy", policy =>
            policy.AllowAnyOrigin()
                  .AllowAnyMethod()
                  .AllowAnyHeader());
    }
{{- end }}
});

var app = builder.Build();

// Middleware pipeline
app.UseResponseCompression();

// Security headers (Security/1.3).
app.Use(async (context, next) =>
{
    context.Response.Headers.Append("X-Content-Type-Options", "nosniff");
    context.Response.Headers.Append("X-Frame-Options", "DENY");
    context.Response.Headers.Append("Referrer-Policy", "strict-origin-when-cross-origin");
    context.Response.Headers.Append("Content-Security-Policy", "default-src 'self'");
    if (app.Environment.IsProduction())
    {
        context.Response.Headers.Append("Strict-Transport-Security", "max-age=31536000; includeSubDomains");
    }
    await next();
});

{{- if .Project.HasRateLimit }}
app.UseRateLimiter();
{{- end }}

if (app.Environment.IsDevelopment())
{
    app.UseSwagger();
    app.UseSwaggerUI(c =>
    {
        c.SwaggerEndpoint("/swagger/v1/swagger.json", "{{ .Project.Name }} API v1");
    });
}

if (!app.Environment.IsEnvironment("Testing"))
{
    app.UseHttpsRedirection();
}
app.UseCors("CorsPolicy");

{{- if .Project.HasAuth }}
app.UseAuthentication();
app.UseAuthorization();
{{- end }}

app.UseOutputCache();

// Map data-layer exceptions to meaningful HTTP status codes instead of a bare 500:
//   DbUpdateConcurrencyException — an optimistic-lock version conflict (409),
//   DbUpdateException           — a FK/unique/constraint violation (409).
app.Use(async (context, next) =>
{
    try
    {
        await next();
    }
    catch (DbUpdateConcurrencyException)
    {
        context.Response.StatusCode = StatusCodes.Status409Conflict;
        await context.Response.WriteAsJsonAsync(new { message = "Concurrency conflict: the resource was modified by another request" });
    }
    catch (DbUpdateException ex)
    {
        context.Response.StatusCode = StatusCodes.Status409Conflict;
        await context.Response.WriteAsJsonAsync(new { message = "A database constraint was violated", detail = ex.Message });
    }
});

app.MapControllers();

// Health Checks endpoint
app.MapHealthChecks("/health", new HealthCheckOptions
{
    ResponseWriter = HealthCheckResponseWriter.WriteResponse,
    Predicate = _ => true
});

app.MapHealthChecks("/health/ready", new HealthCheckOptions
{
    ResponseWriter = HealthCheckResponseWriter.WriteResponse,
    Predicate = check => check.Tags.Contains("ready")
});

app.MapHealthChecks("/health/live", new HealthCheckOptions
{
    Predicate = _ => false
});

{{- if and (gt (len .Project.Entities) 0) (.Project.HasAddon "dapr") }}
// Hangfire dashboard + a periodic data-health/seed job (job only when seed data exists).
app.UseHangfireDashboard();
{{- if $hasSeed }}
RecurringJob.AddOrUpdate<DomainSeeder>("seed-check", seeder => seeder.SeedAsync(), Cron.Daily);
{{- end }}
{{- end }}

// Database setup and seeding (skip in Testing environment - tests manage their own database)
if (!app.Environment.IsEnvironment("Testing"))
{
    using (var scope = app.Services.CreateScope())
    {
        var logger = scope.ServiceProvider.GetRequiredService<ILogger<Program>>();
        try
        {
            var dbContext = scope.ServiceProvider.GetRequiredService<DomainDbContext>();

            // One, explicit schema strategy (never mix): `Database:SchemaMode`.
            //   "ensureCreated" (default) — creates the schema directly; fast for dev, but it does
            //     NOT create the __EFMigrationsHistory table, so it is incompatible with the
            //     `domaincraft generate --migrate` EF-migration workflow.
            //   "migrate" — applies pending EF Core migrations (`dotnet ef database update`),
            //     creating the history table. Choose this once you manage schema via migrations.
            // Mixing the two against the same database produces conflicting schema state, so pick
            // one per environment and keep the appsettings value consistent with your tooling.
            var schemaMode = builder.Configuration["Database:SchemaMode"] ?? "ensureCreated";
            if (schemaMode == "migrate")
            {
                await dbContext.Database.MigrateAsync();
            }
            else
            {
                await dbContext.Database.EnsureCreatedAsync();
            }

            // Run seeder (only when the domain declares seed data)
{{- if $hasSeed }}
            var seeder = scope.ServiceProvider.GetRequiredService<DomainSeeder>();
            await seeder.SeedAsync();
{{- end }}
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "An error occurred during database initialization");
        }
    }
}

app.Run();

// Make Program accessible for integration tests
public partial class Program { }

