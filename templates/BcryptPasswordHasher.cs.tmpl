using {{ $proj }}.Application.Security;
using BCrypt.Net;

namespace {{ $proj }}.Infrastructure.Security;

/// <summary>
/// BCrypt-based password hasher (work factor 12). Passwords are salted + hashed
/// on registration and verified on login — never stored or compared in plain text.
/// </summary>
public class BcryptPasswordHasher : IPasswordHasher
{
    private const int WorkFactor = 12;

    public string HashPassword(string password) =>
        BCrypt.Net.BCrypt.HashPassword(password, workFactor: WorkFactor);

    public bool VerifyPassword(string hashedPassword, string providedPassword)
    {
        if (string.IsNullOrEmpty(hashedPassword))
        {
            return false;
        }
        return BCrypt.Net.BCrypt.Verify(providedPassword, hashedPassword);
    }
}