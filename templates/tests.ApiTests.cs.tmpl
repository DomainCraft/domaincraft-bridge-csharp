    private async Task DropDatabaseAsync(PostgreSqlContainer container)
    {
        // Release app-side pooled connections and force-terminate any remaining
        // backends, otherwise DROP DATABASE fails with 55006 "is being accessed".
        NpgsqlConnection.ClearAllPools();
        var adminCs = new NpgsqlConnectionStringBuilder(container.GetConnectionString())
        {
            Database = "postgres",
