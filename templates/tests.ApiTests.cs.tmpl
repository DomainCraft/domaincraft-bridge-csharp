        await using var conn = new NpgsqlConnection(adminCs.ConnectionString);
        await conn.OpenAsync();
        await using (var term = new NpgsqlCommand(
            $"SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '{_dbName}' AND pid <> pg_backend_pid()", conn))
        {
