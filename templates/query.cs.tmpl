/// <summary>
/// Parses the DomainCraft filter grammar (spec/query.md) into a <see cref="FilterNode"/>.
/// Field/operator validation is driven by the per-entity schema the core emits
/// (scalar fields, one-hop relation paths and JSON roots), so this parser
/// carries no domain-specific knowledge of its own.
/// </summary>
public static class FilterParser
{
    public static FilterNode? Parse(string? input, IReadOnlyDictionary<string, FilterOperator[]> allowed, IReadOnlyDictionary<string, FilterOperator[]>? jsonRoots = null)
    {
        if (string.IsNullOrWhiteSpace(input)) return null;
        return ParseOr(input.Trim(), allowed, jsonRoots);
    }

    private static FilterNode ParseOr(string s, IReadOnlyDictionary<string, FilterOperator[]> allowed, IReadOnlyDictionary<string, FilterOperator[]>? jsonRoots)
    {
        var parts = SplitTopLevel(s, '|');
        if (parts.Count == 1) return ParseAnd(parts[0].Trim(), allowed, jsonRoots);
        return FilterNode.Or(parts.Select(p => ParseAnd(p.Trim(), allowed, jsonRoots)).ToArray());
    }

    private static FilterNode ParseAnd(string s, IReadOnlyDictionary<string, FilterOperator[]> allowed, IReadOnlyDictionary<string, FilterOperator[]>? jsonRoots)
    {
        var parts = SplitTopLevel(s, ',');
        if (parts.Count == 1) return ParseTerm(parts[0].Trim(), allowed, jsonRoots);
        return FilterNode.And(parts.Select(p => ParseTerm(p.Trim(), allowed, jsonRoots)).ToArray());
    }

    private static FilterNode ParseTerm(string s, IReadOnlyDictionary<string, FilterOperator[]> allowed, IReadOnlyDictionary<string, FilterOperator[]>? jsonRoots)
    {
        var parts = s.Split(':');
        if (parts.Length != 3)
            throw new FormatException($"Invalid filter term '{s}' (want field:op:value)");

        var field = parts[0].Trim();
        var opStr = parts[1].Trim();
        var raw = parts[2].Trim();

        if (!Enum.TryParse<FilterOperator>(opStr, ignoreCase: true, out var op))
            throw new FormatException($"Unknown filter operator '{opStr}'");

        FilterOperator[] ops;
        if (TryGetJsonRoot(field, jsonRoots, out var jsonOps))
        {
            ops = jsonOps;
        }
        else if (!allowed.TryGetValue(field, out var a))
        {
            throw new FormatException($"Unknown filter field '{field}'");
        }
        else
        {
            ops = a;
        }

        if (!ops.Contains(op))
            throw new FormatException($"Field '{field}' does not support operator '{opStr}'");

        string[] values;
        if (op == FilterOperator.In)
        {
            if (raw.Length < 2 || raw[0] != '(' || raw[^1] != ')')
                throw new FormatException("Operator 'in' expects a parenthesized list (v1,v2,...)");
            values = raw[1..^1].Split(',').Select(v => v.Trim()).ToArray();
        }
        else
        {
            values = new[] { raw };
        }

        return FilterNode.Compare(field, op, values);
    }

    // A JSON path is "jsonRoot.key[.key...]" — the first segment names a json/jsonb
    // field and at least one key follows. The root's operator set (jsonb → full
    // incl. ordered/numeric, json → text-only) is returned for validation.
    private static bool TryGetJsonRoot(string field, IReadOnlyDictionary<string, FilterOperator[]>? jsonRoots, out FilterOperator[] ops)
    {
        ops = Array.Empty<FilterOperator>();
        if (jsonRoots == null || jsonRoots.Count == 0) return false;
        var dot = field.IndexOf('.');
        if (dot <= 0) return false;
        var root = field.Substring(0, dot);
        return jsonRoots.TryGetValue(root, out ops);
    }

    private static List<string> SplitTopLevel(string s, char sep)
    {
        var parts = new List<string>();
        var depth = 0;
        var start = 0;
        for (var i = 0; i < s.Length; i++)
        {
            var c = s[i];
            if (c == '(') depth++;
            else if (c == ')') depth--;
            else if (c == sep && depth == 0) { parts.Add(s[start..i]); start = i + 1; }
        }
        parts.Add(s[start..]);
        return parts;
    }
}

/// <summary>
/// Translates a <see cref="FilterNode"/> AST into a LINQ expression over <typeparamref name="T"/>.
/// A dotted path is walked reflectively: non-terminal segments navigate to-one
/// relations, a <see cref="JsonDocument"/>/<see cref="JsonElement"/> segment switches
/// into JSON key extraction, and a terminal segment is compared as a scalar. The
/// core already decided which fields/operators are legal.
/// </summary>
public static class FilterExpression
{
    public static Expression<Func<T, bool>> Build<T>(FilterNode node)
    {
        var p = Expression.Parameter(typeof(T), "e");
        var body = BuildNode<T>(node, p);
        return Expression.Lambda<Func<T, bool>>(body, p);
    }

    private static Expression BuildNode<T>(FilterNode node, ParameterExpression p)
    {
        if (node.Kind == "and" || node.Kind == "or")
        {
            Expression? acc = null;
            foreach (var child in node.Children)
            {
                var c = BuildNode<T>(child, p);
                acc = acc == null
                    ? c
                    : (node.Kind == "and" ? Expression.AndAlso(acc, c) : Expression.OrElse(acc, c));
            }
            return acc ?? Expression.Constant(node.Kind == "and");
        }
        return BuildCompare<T>(node.Field!, node.Op, node.Values, p);
    }

    private static Expression BuildCompare<T>(string field, FilterOperator op, IReadOnlyList<string> values, ParameterExpression p)
    {
        var segments = field.Split('.');
        Expression current = p;
        Type currentType = typeof(T);
        for (var i = 0; i < segments.Length; i++)
        {
            var prop = currentType.GetProperty(segments[i], BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase)
                ?? throw new InvalidOperationException($"Unknown filter field '{field}' on {typeof(T).Name}");
            var propType = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
            var member = Expression.Property(current, prop);

            if (propType == typeof(JsonDocument) || propType == typeof(JsonElement))
            {
                // JSON path: the remaining segments are object keys.
                var keys = segments.Skip(i + 1).ToArray();
                return BuildJsonCompare(member, propType, keys, op, values);
            }
            if (i == segments.Length - 1)
            {
                return BuildScalarCompare(member, propType, op, values);
            }

            // Non-terminal non-JSON segment: a to-one relation navigation.
            current = member;
            currentType = propType;
        }
        throw new InvalidOperationException($"Empty filter field '{field}'");
    }

    private static Expression BuildScalarCompare(Expression member, Type type, FilterOperator op, IReadOnlyList<string> values)
    {
        var left = member.Type == type ? member : (Expression)Expression.Convert(member, type);

        object ConvertValue(string v)
        {
            if (type.IsEnum) return ParseEnumValue(type, v);
            if (type == typeof(Guid)) return Guid.Parse(v);
            if (type == typeof(DateTime)) return DateTime.Parse(v, null, DateTimeStyles.RoundtripKind);
            return Convert.ChangeType(v, type, CultureInfo.InvariantCulture) ?? throw new InvalidOperationException($"Cannot convert '{v}' to {type.Name}");
        }

        switch (op)
        {
            case FilterOperator.Eq: return Expression.Equal(left, Expression.Constant(ConvertValue(values[0]), type));
            case FilterOperator.Ne: return Expression.NotEqual(left, Expression.Constant(ConvertValue(values[0]), type));
            case FilterOperator.Gt: return Expression.GreaterThan(left, Expression.Constant(ConvertValue(values[0]), type));
            case FilterOperator.Gte: return Expression.GreaterThanOrEqual(left, Expression.Constant(ConvertValue(values[0]), type));
            case FilterOperator.Lt: return Expression.LessThan(left, Expression.Constant(ConvertValue(values[0]), type));
            case FilterOperator.Lte: return Expression.LessThanOrEqual(left, Expression.Constant(ConvertValue(values[0]), type));
            case FilterOperator.Contains: return Expression.Call(left, Method("Contains"), Expression.Constant(values[0]));
            case FilterOperator.StartsWith: return Expression.Call(left, Method("StartsWith"), Expression.Constant(values[0]));
            case FilterOperator.EndsWith: return Expression.Call(left, Method("EndsWith"), Expression.Constant(values[0]));
            case FilterOperator.In:
            {
                var listType = typeof(List<>).MakeGenericType(type);
                var list = (IList)Activator.CreateInstance(listType)!;
                foreach (var v in values) list.Add(ConvertValue(v));
                var contains = listType.GetMethod("Contains", new[] { type })!;
                return Expression.Call(Expression.Constant(list), contains, left);
            }
            default: throw new InvalidOperationException($"Unsupported filter operator {op}");
        }
    }

    // Matches an enum filter value against the canonical wire value (the
    // [EnumMember] snake_case form the core emits and the API serializes) first,
    // then falls back to the member name (case-insensitive) for compatibility.
    // Without this, a client round-tripping the serialized value (e.g.
    // "in_progress") would fail Enum.Parse, which only knows member names.
    private static object ParseEnumValue(Type type, string v)
    {
        foreach (var name in Enum.GetNames(type))
        {
            var member = type.GetMember(name)[0];
            var wire = member.GetCustomAttribute<EnumMemberAttribute>()?.Value;
            if (wire != null && string.Equals(wire, v, StringComparison.OrdinalIgnoreCase))
                return Enum.Parse(type, name);
            if (string.Equals(name, v, StringComparison.OrdinalIgnoreCase))
                return Enum.Parse(type, name);
        }
        throw new FormatException($"Invalid value '{v}' for enum {type.Name}");
    }

    private static Expression BuildJsonCompare(Expression member, Type jsonType, string[] keys, FilterOperator op, IReadOnlyList<string> values)
    {
        // Navigate to the JsonElement (RootElement for JsonDocument), then walk the keys.
        Expression acc = jsonType == typeof(JsonDocument)
            ? Expression.Property(member, "RootElement")
            : member;
        foreach (var key in keys)
        {
            acc = Expression.Call(acc, "GetProperty", null, Expression.Constant(key));
        }

        // Ordered operators carry numeric semantics (CAST(... AS numeric)); the rest
        // carry text semantics (->> / #>>).
        if (op == FilterOperator.Gt || op == FilterOperator.Gte || op == FilterOperator.Lt || op == FilterOperator.Lte)
        {
            var numeric = Expression.Call(acc, "GetDecimal", null);
            var dec = Expression.Constant(decimal.Parse(values[0], CultureInfo.InvariantCulture), typeof(decimal));
            return op switch
            {
                FilterOperator.Gt => Expression.GreaterThan(numeric, dec),
                FilterOperator.Gte => Expression.GreaterThanOrEqual(numeric, dec),
                FilterOperator.Lt => Expression.LessThan(numeric, dec),
                _ => Expression.LessThanOrEqual(numeric, dec),
            };
        }

        var text = Expression.Call(acc, "GetString", null);
        switch (op)
        {
            case FilterOperator.Eq: return Expression.Equal(text, Expression.Constant(values[0]));
            case FilterOperator.Ne: return Expression.NotEqual(text, Expression.Constant(values[0]));
            case FilterOperator.Contains: return Expression.Call(text, Method("Contains"), Expression.Constant(values[0]));
            case FilterOperator.StartsWith: return Expression.Call(text, Method("StartsWith"), Expression.Constant(values[0]));
            case FilterOperator.EndsWith: return Expression.Call(text, Method("EndsWith"), Expression.Constant(values[0]));
            case FilterOperator.In:
            {
                var list = values.ToList();
                var contains = typeof(List<string>).GetMethod("Contains", new[] { typeof(string) })!;
                return Expression.Call(Expression.Constant(list), contains, text);
            }
            default: throw new InvalidOperationException($"Unsupported JSON filter operator {op}");
        }
    }

    private static MethodInfo Method(string name) => typeof(string).GetMethod(name, new[] { typeof(string) })!;
}

