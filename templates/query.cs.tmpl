/// <summary>
/// Parses the DomainCraft sort grammar (spec/query.md) — comma-separated keys,
/// an optional leading '-' (descending) or '+' (ascending) — validating every
/// key against the per-entity sortable map the core emits.
/// </summary>
public static class SortParser
{
    public static IReadOnlyList<SortKey> Parse(string? input, IReadOnlyDictionary<string, string> sortable)
    {
        if (string.IsNullOrWhiteSpace(input)) return Array.Empty<SortKey>();

        var result = new List<SortKey>();
        foreach (var raw in input.Split(','))
        {
            var key = raw.Trim();
            if (key.Length == 0)
                throw new FormatException($"Empty sort key in '{input}'");

            var desc = false;
            if (key[0] == '-' || key[0] == '+')
            {
                desc = key[0] == '-';
                key = key[1..].Trim();
            }
            if (key.Length == 0)
                throw new FormatException($"Empty sort key in '{input}'");

            if (!sortable.TryGetValue(key, out var canonical))
                throw new FormatException($"Unknown sort field '{key}'");

            result.Add(new SortKey(canonical, desc));
        }
        return result;
    }
}

/// <summary>
/// Applies an ordered, multi-key sort to an IQueryable via reflection, so the
/// per-entity sortable list stays data-driven (no switch, no hand-written
/// OrderBy per field).
/// </summary>
public static class SortApplier
{
    public static IQueryable<T> Apply<T>(IQueryable<T> query, IReadOnlyList<SortKey> keys)
    {
        IOrderedQueryable<T>? ordered = null;
        foreach (var key in keys)
        {
            var selector = BuildSelector<T>(key.Property);
            var methodName = ordered == null
                ? (key.Descending ? nameof(Queryable.OrderByDescending) : nameof(Queryable.OrderBy))
                : (key.Descending ? nameof(Queryable.ThenByDescending) : nameof(Queryable.ThenBy));

            var method = FindSortMethod(methodName).MakeGenericMethod(typeof(T), selector.ReturnType);
            var source = (IQueryable)(ordered ?? query);
            ordered = (IOrderedQueryable<T>)method.Invoke(null, new object[] { source, selector })!;
        }
        return ordered ?? query;
    }

    private static LambdaExpression BuildSelector<T>(string property)
    {
        var parameter = Expression.Parameter(typeof(T), "e");
        var member = typeof(T).GetProperty(property, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase)
            ?? throw new InvalidOperationException($"Unknown sort property '{property}' on {typeof(T).Name}");
        return Expression.Lambda(Expression.Property(parameter, member), parameter);
    }

    private static MethodInfo FindSortMethod(string name)
    {
        return typeof(Queryable).GetMethods(BindingFlags.Public | BindingFlags.Static)
            .First(m => m.Name == name && m.GetParameters().Length == 2);
    }
}

/// <summary>
/// The normalized list-query contract (the runtime mirror of the core's IRQuery):
/// the raw search/filter/sort strings plus clamped pagination. The repository
/// resolves the strings against the entity's filterable/sortable schema.
/// </summary>
public sealed class ListQuery
{
    public string? Search { get; init; }
    public string? Filter { get; init; }
    public string? Sort { get; init; }
    public int Page { get; init; }
    public int PageSize { get; init; }

    /// <summary>Keyset cursor (the primary key of the last row seen), when present.</summary>
    public string? Cursor { get; init; }

    /// <summary>Comma-separated relation field names to eager-load; null = load all.</summary>
    public string? Include { get; init; }

    /// <summary>
    /// When true, the query is restricted to rows owned by <see cref="OwnerId"/>
    /// (an @Owner read). The repository turns this into a SQL WHERE over the
    /// entity's owner columns so pagination and TotalCount stay correct — filtering
    /// a fetched page in memory would under-fill pages and misreport totals.
    /// </summary>
    public bool OwnerOnly { get; set; }

    /// <summary>Current user id for an owner-scoped read. Ignored unless <see cref="OwnerOnly"/> is true.</summary>
    public Guid OwnerId { get; set; }

    /// <summary>True when the caller requested keyset pagination via <see cref="Cursor"/>.</summary>
    public bool HasCursor => !string.IsNullOrEmpty(Cursor);

    /// <summary>
    /// Reports whether the named relation (its camelCase JSON field name) should be
    /// eager-loaded. A null <see cref="Include"/> means "load everything" (the
    /// default); an explicit value (possibly empty) restricts to the listed names.
    /// </summary>
    public bool ShouldInclude(string relation) =>
        Include == null ||
        Include.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Contains(relation, StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Normalizes transport parameters into a ListQuery: `limit` wins over
    /// `pageSize`, the default fills in, and page/pageSize are clamped (the
    /// runtime mirror of IRPaginationConfig.NormalizePage/EffectivePageSize).
    /// </summary>
    public static ListQuery FromQuery(int page, int? pageSize, int? limit, string? sort, string? search, string? filter, string? cursor, string? include, int defaultPageSize, int maxPageSize)
    {
        var size = limit ?? pageSize ?? defaultPageSize;
        size = Math.Clamp(size, 1, maxPageSize);
        return new ListQuery
        {
            Search = search,
            Filter = filter,
            Sort = sort,
            Cursor = cursor,
            Include = include,
            Page = Math.Max(1, page),
            PageSize = size,
        };
    }
}
