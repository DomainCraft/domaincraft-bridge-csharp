{{- $entity := .Entity.Name -}}
{{- $perms := .Permissions -}}
{{- $pk := .PrimaryKey -}}
{{- $pkType := "Guid" -}}
{{- if $pk }}{{ $pkType = languageType $pk.DatabaseType false }}{{ end -}}
using System.ComponentModel.DataAnnotations;
using System.Text.Json;
using System.Text.Json.Serialization;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.RateLimiting;
using Asp.Versioning;
using {{ $proj }}.Application.Security;
using {{ $proj }}.Application.Services;
using {{ $proj }}.Domain.Entities;
using {{ $proj }}.Domain.Shared;

namespace {{ $proj }}.WebApi.Controllers;

/// <summary>
/// REST API Controller for {{ pluralize $entity }} resource
/// </summary>
[ApiController]
{{- if .Project.HasVersioning }}
[ApiVersion("{{ .Project.Versioning.DefaultVersion }}")]
{{- end }}
[Route("api/[controller]")]
[Produces("application/json")]
{{- if .Project.HasRateLimit }}
[EnableRateLimiting("api")]
{{- end }}
public class {{ pluralize $entity }}Controller : ControllerBase
{
    private readonly I{{ $entity }}Service _service;
    private readonly IPermissionService _permissionService;
    private readonly ILogger<{{ pluralize $entity }}Controller> _logger;

    public {{ pluralize $entity }}Controller(
        I{{ $entity }}Service service,
        IPermissionService permissionService,
        ILogger<{{ pluralize $entity }}Controller> logger)
    {
        _service = service ?? throw new ArgumentNullException(nameof(service));
        _permissionService = permissionService ?? throw new ArgumentNullException(nameof(permissionService));
        _logger = logger ?? throw new ArgumentNullException(nameof(logger));
    }

    /// <summary>
    /// Get all {{ pluralize $entity | lowercase }}
    /// </summary>
{{- template "authOrAuthorize" (dict "Roles" (and $perms $perms.Read) "PermsDefined" (ne $perms nil) "Entity" $entity "Op" "Read") }}
    [HttpGet]
    [ProducesResponseType(typeof(PagedResult<{{ $entity }}Dto>), StatusCodes.Status200OK)]
    public async Task<ActionResult<PagedResult<{{ $entity }}Dto>>> GetAll(
        [FromQuery] int page = 1,
        [FromQuery] int pageSize = {{ .Project.Pagination.DefaultPageSize }},
        [FromQuery] string? sort = null,
        [FromQuery] string? search = null)
    {
        _logger.LogInformation("GET /api/{{ pluralize $entity | lowercase }} - page {Page} size {PageSize}", page, pageSize);
        var result = await _service.GetPagedAsync(page, pageSize, sort, search);
        var dtos = result.Items.Select(MapToDto).ToList();
        return Ok(new PagedResult<{{ $entity }}Dto>
        {
            Items = dtos,
            TotalCount = result.TotalCount,
            Page = result.Page,
            PageSize = result.PageSize
        });
    }

    /// <summary>
    /// Get a specific {{ $entity | lowercase }} by ID
    /// </summary>
{{- template "authOrAuthorize" (dict "Roles" (and $perms $perms.Read) "PermsDefined" (ne $perms nil) "Entity" $entity "Op" "Read") }}
    [HttpGet("{id}")]
    [ProducesResponseType(typeof({{ $entity }}Dto), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<ActionResult<{{ $entity }}Dto>> GetById({{ $pkType }} id)
    {
        _logger.LogInformation("GET /api/{{ pluralize $entity | lowercase }}/{id}", id);
        var entity = await _service.GetByIdAsync(id);
        if (entity == null)
        {
            _logger.LogWarning("{{ $entity }} with ID {id} not found", id);
            return NotFound();
        }
        var dto = MapToDto(entity);
        return Ok(dto);
    }

    /// <summary>
    /// Create a new {{ $entity | lowercase }}
    /// </summary>
{{- template "authOrAuthorize" (dict "Roles" (and $perms $perms.Create) "PermsDefined" (ne $perms nil) "Entity" $entity "Op" "Create") }}
    [HttpPost]
    [ProducesResponseType(typeof({{ $entity }}Dto), StatusCodes.Status201Created)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    public async Task<ActionResult<{{ $entity }}Dto>> Create([FromBody] Create{{ $entity }}Request request)
    {
        _logger.LogInformation("POST /api/{{ pluralize $entity | lowercase }} - creating new {{ $entity | lowercase }}");

        var entity = new {{ $entity }}();
        MapCreateRequestToEntity(request, entity);

{{- if .HasAuditLog }}
        entity.CreatedBy = GetCurrentUserId();
        entity.UpdatedBy = GetCurrentUserId();
{{- end }}

        await _service.CreateAsync(entity);
        var dto = MapToDto(entity);
        return CreatedAtAction(nameof(GetById), new { id = entity.{{ if .PrimaryKey }}{{ .PrimaryKey.Name | pascalcase }}{{ else }}Id{{ end }} }, dto);
    }

    /// <summary>
    /// Update an existing {{ $entity | lowercase }}
    /// </summary>
{{- template "authOrAuthorize" (dict "Roles" (and $perms $perms.Update) "PermsDefined" (ne $perms nil) "Entity" $entity "Op" "Update") }}
    [HttpPut("{id}")]
    [ProducesResponseType(typeof({{ $entity }}Dto), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    public async Task<ActionResult<{{ $entity }}Dto>> Update({{ $pkType }} id, [FromBody] Update{{ $entity }}Request request)
    {
        _logger.LogInformation("PUT /api/{{ pluralize $entity | lowercase }}/{id}", id);
        var existingEntity = await _service.GetByIdAsync(id);
        if (existingEntity == null)
        {
            _logger.LogWarning("{{ $entity }} with ID {id} not found for update", id);
            return NotFound();
        }
{{- if and $perms $perms.Update (hasOwnershipToken $perms.Update) }}
        // @Owner check: forbid unless the caller is the owner or holds an explicit role.
        if ({{ template "ownerCheck" (dict "Roles" $perms.Update "Var" "existingEntity") }})
        {
            return Forbid();
        }
{{- end }}
        MapUpdateRequestToEntity(request, existingEntity);

{{- if .HasOptimisticLock }}
        if (request.Version.HasValue)
        {
            existingEntity.Version = request.Version.Value;
        }
{{- end }}
{{- if .HasAuditLog }}
        existingEntity.UpdatedBy = GetCurrentUserId();
{{- end }}

        var updated = await _service.UpdateAsync(id, existingEntity);
        if (updated == null)
        {
            _logger.LogWarning("{{ $entity }} with ID {id} not found for update", id);
            return NotFound();
        }
        var dto = MapToDto(updated);
        return Ok(dto);
    }

    /// <summary>
    /// Partially update a {{ $entity | lowercase }} — only the scalar fields present
    /// in the JSON body are applied (System.Text.Json merge patch; no JSON Patch SDK).
    /// </summary>
{{- template "authOrAuthorize" (dict "Roles" (and $perms $perms.Update) "PermsDefined" (ne $perms nil) "Entity" $entity "Op" "Update") }}
    [HttpPatch("{id}")]
    [ProducesResponseType(typeof({{ $entity }}Dto), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    public async Task<ActionResult<{{ $entity }}Dto>> Patch({{ $pkType }} id, [FromBody] JsonElement patch)
    {
        _logger.LogInformation("PATCH /api/{{ pluralize $entity | lowercase }}/{id}", id);
        var existingEntity = await _service.GetByIdAsync(id);
        if (existingEntity == null)
        {
            _logger.LogWarning("{{ $entity }} with ID {id} not found for patch", id);
            return NotFound();
        }
{{- if and $perms $perms.Update (hasOwnershipToken $perms.Update) }}
        // @Owner check: forbid unless the caller is the owner or holds an explicit role.
        if ({{ template "ownerCheck" (dict "Roles" $perms.Update "Var" "existingEntity") }})
        {
            return Forbid();
        }
{{- end }}
        try
        {
            ApplyPatch(patch, existingEntity);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Invalid patch applied to {{ $entity }} {id}", id);
            return BadRequest(new { message = "Invalid patch document" });
        }
{{- if .HasAuditLog }}
        existingEntity.UpdatedBy = GetCurrentUserId();
{{- end }}
        // Partial (merge-patch) update: the entity is already change-tracked here, so
        // UpdatePartialAsync persists only the properties touched by ApplyPatch.
        var updated = await _service.UpdatePartialAsync(id, existingEntity);
        if (updated == null)
        {
            _logger.LogWarning("{{ $entity }} with ID {id} not found for patch", id);
            return NotFound();
        }
        return Ok(MapToDto(updated));
    }

    /// <summary>
    /// Delete a {{ $entity | lowercase }}
    /// </summary>
{{- template "authOrAuthorize" (dict "Roles" (and $perms $perms.Delete) "PermsDefined" (ne $perms nil) "Entity" $entity "Op" "Delete") }}
    [HttpDelete("{id}")]
    [ProducesResponseType(StatusCodes.Status204NoContent)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<IActionResult> Delete({{ $pkType }} id)
    {
        _logger.LogInformation("DELETE /api/{{ pluralize $entity | lowercase }}/{id}", id);
        var entity = await _service.GetByIdAsync(id);
        if (entity == null)
        {
            _logger.LogWarning("{{ $entity }} with ID {id} not found for deletion", id);
            return NotFound();
        }
{{- if and $perms $perms.Delete (hasOwnershipToken $perms.Delete) }}
        // @Owner check: forbid unless the caller is the owner or holds an explicit role.
        if ({{ template "ownerCheck" (dict "Roles" $perms.Delete "Var" "entity") }})
        {
            return Forbid();
        }
{{- end }}
        var deleted = await _service.DeleteAsync(id);
        if (!deleted)
        {
            _logger.LogWarning("{{ $entity }} with ID {id} not found for deletion", id);
            return NotFound();
        }

        _logger.LogInformation("{{ $entity }} with ID {id} deleted successfully", id);
        return NoContent();
    }

// ===================== DTOs =====================

    public class {{ $entity }}Dto
    {
{{- range .Entity.Fields }}
{{- if or (isFeatureField .Name) (eq (lower .Name) "password") }}
{{- else if .IsPrimary }}
        public {{ languageType .DatabaseType .IsNullable }} {{ .Name | pascalcase }} { get; set; }
{{- else }}
{{- template "dtoFieldProperties" . }}
{{- end }}
{{- end }}
{{- if .HasAudit }}
        public DateTime CreatedAt { get; set; }
        public DateTime UpdatedAt { get; set; }
{{- end }}
{{- if .HasAuditLog }}
        public Guid CreatedBy { get; set; }
        public Guid UpdatedBy { get; set; }
{{- end }}
{{- if .HasSoftDelete }}
        public DateTime? DeletedAt { get; set; }
{{- end }}
{{- if .HasOptimisticLock }}
        public int Version { get; set; }
{{- end }}
    }

    public class Create{{ $entity }}Request
    {
{{- range .Entity.Fields }}
{{- if or (isFeatureField .Name) (eq (lower .Name) "password") }}
{{- else if not .IsPrimary }}
{{- template "requestFieldProperties" . }}
{{- end }}
{{- end }}
    }

    public class Update{{ $entity }}Request
    {
{{- range .Entity.Fields }}
{{- if or (isFeatureField .Name) (eq (lower .Name) "password") }}
{{- else if not .IsPrimary }}
{{- template "requestFieldProperties" . }}
{{- end }}
{{- end }}
{{- if .HasOptimisticLock }}
        [JsonPropertyName("version")]
        public int? Version { get; set; }
{{- end }}
    }

    // ===================== Mappers =====================

    private {{ $entity }}Dto MapToDto({{ $entity }} entity)
    {
        return new {{ $entity }}Dto
        {
{{- range .Entity.Fields }}
{{- if or (isFeatureField .Name) (eq (lower .Name) "password") }}
{{- else if .IsPrimary }}
            {{ .Name | pascalcase }} = entity.{{ .Name | pascalcase }},
{{- else }}
{{- template "mapFieldToDto" . }}
{{- end }}
{{- end }}
{{- if .HasAudit }}
            CreatedAt = entity.CreatedAt,
            UpdatedAt = entity.UpdatedAt,
{{- end }}
{{- if .HasAuditLog }}
            CreatedBy = entity.CreatedBy,
            UpdatedBy = entity.UpdatedBy,
{{- end }}
{{- if .HasSoftDelete }}
            DeletedAt = entity.DeletedAt,
{{- end }}
{{- if .HasOptimisticLock }}
            Version = entity.Version,
{{- end }}
        };
    }

    private void MapCreateRequestToEntity(Create{{ $entity }}Request request, {{ $entity }} entity)
    {
{{- range .Entity.Fields }}
{{- if or (isFeatureField .Name) (eq (lower .Name) "password") }}
{{- else if not .IsPrimary }}
{{- template "mapRequestToEntity" . }}
{{- end }}
{{- end }}
    }

    private void MapUpdateRequestToEntity(Update{{ $entity }}Request request, {{ $entity }} entity)
    {
{{- range .Entity.Fields }}
{{- if or (isFeatureField .Name) (eq (lower .Name) "password") }}
{{- else if not .IsPrimary }}
{{- template "mapRequestToEntity" . }}
{{- end }}
{{- end }}
    }

    /// <summary>
    /// Merge-patch via System.Text.Json: each scalar field present in the patch
    /// body is deserialized and assigned. Ids, relations, arrays, enums and JSON
    /// blobs are intentionally ignored (they are not meant for partial updates).
    /// </summary>
    private void ApplyPatch(JsonElement patch, {{ $entity }} entity)
    {
        if (patch.ValueKind != JsonValueKind.Object)
        {
            throw new ArgumentException("Patch body must be a JSON object", nameof(patch));
        }
{{- range .Entity.Fields }}
{{- if or (isFeatureField .Name) (eq (lower .Name) "password") }}
{{- else if .IsPrimary }}
{{- else if .IsRelation }}
{{- else if .IsArray }}
{{- else if (isEnumType .DatabaseType) }}
{{- else if eq .DatabaseType "json" }}
{{- else if eq .DatabaseType "jsonb" }}
{{- else }}
        if (patch.TryGetProperty("{{ .Name | camelcase }}", out var {{ .Name | camelcase }}El))
        {
            entity.{{ .Name | pascalcase }} = {{ .Name | camelcase }}El.Deserialize<{{ languageType .DatabaseType .IsNullable }}>();
        }
{{- end }}
{{- end }}
    }

    private Guid GetCurrentUserId()
    {
        var userIdClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? User.FindFirst("sub")?.Value;
        if (Guid.TryParse(userIdClaim, out var userId))
        {
            return userId;
        }
        return Guid.Empty;
    }
}
